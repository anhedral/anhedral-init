{
  "name": "anhedral",
  "version": "0.6.0",
  "description": "Initialize client-owned applications with shadcn, pnpm, Turborepo, and Cloudflare-first services.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "anhedral": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets/anhedral-cli-init.svg",
    "assets/anhedral-cli-init-technical.svg",
    "assets/images/svg/logo-white-subtract.svg",
    "LICENSE",
    "README.md",
    "anhedral.svg",
    "favicon.ico",
    "docs/application-stack-standard.md"
  ],
  "homepage": "https://github.com/anhedral/anhedral-init#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhedral/anhedral-init.git"
  },
  "bugs": {
    "url": "https://github.com/anhedral/anhedral-init/issues"
  },
  "author": "Anhedral, Inc.",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "scaffold": "node dist/bin.js init",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && tsc && node scripts/prepare-cli.mjs",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "check:hygiene": "node scripts/check-source-hygiene.mjs",
    "check:security": "node scripts/check-security-policy.mjs",
    "check:release-policy": "node scripts/check-release-policy.mjs",
    "check:release-secrets": "node scripts/check-release-secrets.mjs",
    "lint": "pnpm typecheck && pnpm check:hygiene && pnpm check:release-policy",
    "audit:osv": "node scripts/audit-osv.mjs",
    "test": "pnpm test:unit",
    "pretest": "pnpm build",
    "prepublishOnly": "pnpm test:all",
    "test:cli:validation": "node --test tests/test-cli-validation.test.mjs",
    "test:pack": "pnpm build && node tests/test-packed-cli.js",
    "test:pack:exact": "node tests/test-packed-cli.js .artifacts/release/metadata.json",
    "test:packlist": "pnpm build && node tests/test-packlist.js",
    "test:release-tooling": "node tests/test-release-tooling.test.mjs",
    "test:all": "pnpm build && pnpm lint && pnpm check:security && pnpm audit:osv && pnpm test:unit && node tests/test-packed-cli.js && node tests/test-packlist.js",
    "release:check": "pnpm test:all",
    "release:pack": "pnpm build && node scripts/create-release-artifact.mjs && node scripts/check-release-secrets.mjs .artifacts/release/metadata.json",
    "release:artifact:verify": "node scripts/verify-release-artifact.mjs .artifacts/release/metadata.json && node scripts/check-release-secrets.mjs .artifacts/release/metadata.json",
    "release:artifact:smoke": "node tests/test-packed-cli.js .artifacts/release/metadata.json",
    "docs:stack-map": "node scripts/render-master-stack-map.mjs",
    "docs:technical-stack-map": "node scripts/render-master-stack-map.mjs --technical",
    "docs:stack-maps": "pnpm docs:stack-map && pnpm docs:technical-stack-map",
    "test:standard": "pnpm build && node --test tests/test-standard.test.mjs",
    "test:unit": "node --test --test-concurrency=4 --test-reporter=spec tests/*.test.mjs"
  },
  "keywords": [
    "cli",
    "scaffold",
    "typescript",
    "nextjs",
    "hono",
    "cloudflare",
    "opennext",
    "expo",
    "electron",
    "wxt",
    "neon",
    "drizzle",
    "shadcn",
    "turborepo"
  ],
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@<=5.0.7": "5.0.8"
    }
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "simple-icons": "16.27.0",
    "typescript": "5.9.3"
  }
}
