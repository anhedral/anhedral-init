{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anhedral-factory-example-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    }
  ],
  "account_id": "77f9c2265a1309ae2592b82f29d3b979",
  "workers_dev": false,
  "preview_urls": false
}
