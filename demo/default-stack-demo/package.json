{
  "name": "anhedral-factory",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:full": "fallow --fail-on-issues",
    "check": "pnpm lint && pnpm typecheck && pnpm run audit && pnpm audit:deps && pnpm test && pnpm build && pnpm build:worker",
    "setup:database": "node scripts/connect-database.mjs",
    "audit:deps": "node scripts/security/audit-deps.mjs --all",
    "build:worker": "pnpm --dir apps/web run build:worker"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "fallow": "3.31.0"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.22.0"
  }
}
