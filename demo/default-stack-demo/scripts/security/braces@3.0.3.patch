diff --git a/lib/limits.js b/lib/limits.js
new file mode 100644
--- /dev/null
+++ b/lib/limits.js
@@ -0,0 +1,102 @@
+'use strict';
+
+// Anhedral's local 3.0.3 security backport. Limits cannot be disabled by options.
+const MAX_DEPTH = 100;
+const MAX_NODES = 20000;
+const MAX_RESULTS = 100000;
+const MAX_CHARS = 10 * 1024 * 1024;
+const fail = () => { throw new RangeError('Brace operation exceeds safe resource limits'); };
+const string = value => {
+  if (String(value).length > MAX_CHARS) fail();
+  return value;
+};
+
+const ast = root => {
+  const work = [[root, 0, false]];
+  const active = new Set();
+  const parentDepths = new Map();
+  let count = 0;
+  let chars = 0;
+  while (work.length) {
+    const [node, depth, leaving] = work.pop();
+    if (leaving) { active.delete(node); continue; }
+    if (!node || (typeof node !== 'object' && typeof node !== 'function')) throw new TypeError('Expected an AST node');
+    if (depth > MAX_DEPTH || ++count > MAX_NODES || active.has(node)) fail();
+    chars += node.value ? String(node.value).length : 0;
+    if (chars > MAX_CHARS) fail();
+    // expand follows parent links independently of the child traversal.
+    const parents = new Set();
+    let parent = node;
+    while (parent && !parentDepths.has(parent)) {
+      if (parents.has(parent) || parents.size > MAX_DEPTH) fail();
+      if (parentDepths.size + parents.size >= MAX_NODES) fail();
+      parents.add(parent);
+      parent = parent.parent;
+    }
+    let parentDepth = parent ? parentDepths.get(parent) : 0;
+    for (const value of [...parents].reverse()) {
+      if (++parentDepth > MAX_DEPTH + 1) fail();
+      parentDepths.set(value, parentDepth);
+    }
+    if (node.nodes) {
+      if (!Array.isArray(node.nodes)) throw new TypeError('Expected AST children');
+      if (node.nodes.length > MAX_NODES || work.length + node.nodes.length > MAX_NODES * 2) fail();
+      active.add(node);
+      work.push([node, depth, true]);
+      for (let i = node.nodes.length - 1; i >= 0; i--) work.push([node.nodes[i], depth + 1, false]);
+    }
+  }
+};
+
+const measure = value => {
+  const work = [[value, 0, false]];
+  const active = new Set();
+  let count = 0;
+  let chars = 0;
+  let visits = 0;
+  while (work.length) {
+    const [item, depth, leaving] = work.pop();
+    if (leaving) { active.delete(item); continue; }
+    if (depth > MAX_DEPTH || ++visits > MAX_RESULTS + MAX_NODES) fail();
+    if (Array.isArray(item)) {
+      if (active.has(item) || item.length > MAX_RESULTS || work.length + item.length > MAX_RESULTS + MAX_NODES) fail();
+      active.add(item);
+      work.push([item, depth, true]);
+      for (let i = item.length - 1; i >= 0; i--) work.push([item[i], depth + 1, false]);
+    } else if (item !== undefined) {
+      count++;
+      chars += String(item).length;
+      if (count > MAX_RESULTS || chars > MAX_CHARS) fail();
+    }
+  }
+  return { count, chars };
+};
+
+const append = (queue, stash, enclose) => {
+  const left = measure(queue);
+  const right = measure(stash);
+  const count = left.count ? left.count * right.count : right.count;
+  const chars = left.count ? left.chars * right.count + right.chars * left.count : right.chars;
+  if (count > MAX_RESULTS || chars + (enclose ? count * 2 : 0) > MAX_CHARS) fail();
+};
+
+// fill-range enumerates descending ranges too; rangeLimit:false must not bypass the cap.
+const range = (args, options, compiling = false) => {
+  const [start, end] = args;
+  const step = Math.max(Math.abs(Number(args[2] === undefined ? options.step || 1 : args[2])), 1);
+  if (compiling && step === 1) return; // Numeric regex ranges do not allocate each member.
+  let a = Number(start);
+  let b = Number(end);
+  if (!Number.isInteger(a) || !Number.isInteger(b)) {
+    if (String(start).length !== 1 || String(end).length !== 1) return;
+    a = String(start).charCodeAt(0);
+    b = String(end).charCodeAt(0);
+  }
+  if (!Number.isSafeInteger(a) || !Number.isSafeInteger(b)) fail();
+  if (!Number.isFinite(step)) return; // fill-range handles invalid steps.
+  const count = Math.floor(Math.abs(b - a) / step) + 1;
+  const width = Math.max(String(start).length, String(end).length, String(args[2] || '').length, 1);
+  if (count > MAX_RESULTS || count * (width + (compiling ? 2 : 0)) > MAX_CHARS) fail();
+};
+
+module.exports = { MAX_DEPTH, MAX_RESULTS, MAX_CHARS, fail, string, ast, measure, append, range };
