{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anhedral-factory-example-scheduled",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "account_id": "77f9c2265a1309ae2592b82f29d3b979",
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "4486f8768a1e49fb9f29f5af08e414bd"
    }
  ],
  "pipelines": [
    {
      "binding": "ANALYTICS",
      "stream": "a4120f4533df40b7ae279ae08fb27ca5"
    }
  ]
}
