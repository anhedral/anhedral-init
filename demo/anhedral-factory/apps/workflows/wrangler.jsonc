{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anhedral-factory-example-workflows",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "anhedral-factory-example-delivery",
      "binding": "WORKFLOW",
      "class_name": "ApplicationWorkflow"
    }
  ],
  "account_id": "77f9c2265a1309ae2592b82f29d3b979",
  "workers_dev": false,
  "preview_urls": false,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5f45654a79ff4c738b3b783cdab0c8d8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "anhedral-factory-example-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
        "script_name": "anhedral-factory-example-realtime"
      }
    ]
  },
  "pipelines": [
    {
      "binding": "ANALYTICS",
      "stream": "a4120f4533df40b7ae279ae08fb27ca5"
    }
  ]
}
